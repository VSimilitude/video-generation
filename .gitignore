node_modules/
out/
# built by `npm run site`; published to gh-pages, never committed on main
dist-site/
.DS_Store
*.log

# Deliberately NOT ignored:
#   public/narration/**        generated audio is committed so any checkout
#                              renders identically without re-running Kokoro
#   public/narration/*/.cache.json
#                              tiny hash file; keeps a fresh clone from
#                              re-synthesizing every clip
#   src/videos/*/narrationManifest.ts
#                              generated, but the durations are what the
#                              compositions time against
#   public/backgrounds/**      generated gouache plates + their .cache.json;
#                              same deal as the audio — committed so a checkout
#                              renders without an API key or a re-spend
#   src/videos/*/backgroundManifest.ts
#                              generated; the compositions import these paths

# API keys for build-time asset generation (image gen); never commit
.env
tmp/
