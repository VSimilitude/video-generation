{
  "name": "video-generation",
  "version": "1.0.0",
  "private": true,
  "description": "Suite of educational videos built with Remotion + Kokoro TTS.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
    "narration": "node scripts/generate-narration.mjs",
    "backgrounds": "node scripts/generate-backgrounds.mjs",
    "deploy": "node scripts/deploy-site.mjs",
    "site": "esbuild src/site/main.tsx --bundle --minify --format=iife --outfile=dist-site/bundle.js --define:process.env.NODE_ENV='\"production\"' && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "lint:hooks": "node scripts/hookscan.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.498"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@remotion/cli": "4.0.498",
    "@remotion/player": "^4.0.498",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "kokoro-js": "1.2.1",
    "typescript": "^5.6.3"
  }
}
